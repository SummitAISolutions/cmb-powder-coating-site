# Summit website starter (templates/website-starter).
#
# Build agents: EXTEND this file, do not replace it. It is a superset of the
# repo-seed .gitignore entries that later stages depend on — in particular
# `.wrangler/`, which the Cloudflare preview deployer writes into the repository
# it deploys from. `npm run validate` in the orchestration repo enforces that.

# Cloudflare Wrangler local cache. Never application source, never committed.
.wrangler/

# Dependencies
node_modules/

# Astro build output and generated types
dist/
.astro/

# Rendered screenshots. Regenerated by `npm run screenshots`; never a source of
# truth, and the critique references them by path.
visual/screenshots/

# Local lead store and test-sink receipts (npm run local). Test data, never committed.
.summit-leads/

# Environment and secrets — never commit these. .dev.vars holds local Pages Function secrets.
.env
.env.*
!.env.example
.dev.vars
*.pem
*.key

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
