---
/**
 * ClosingPanel — every page ends here (approved visual direction: "Closing
 * panel on every page with its own image inset"): a steel-tint panel with the
 * heading, one line, the amber call pill and the quote action, beside a
 * generated image inset in the panel. Each page passes its own image. The
 * phone comes from the entity; the image is generated supporting imagery with
 * empty alt.
 *
 * quoteCta: mark the quote link as the "quote" conversion CTA (only on the
 * routes search/site.json lists for it). quoteHref: where it goes.
 */
import type { ImageMetadata } from 'astro';
import EntityFact from './primitives/EntityFact.astro';
import ResponsiveImage from './primitives/ResponsiveImage.astro';

interface Props {
  heading: string;
  image: ImageMetadata;
  slotId: string;
  focal?: string;
  quoteCta?: boolean;
  quoteHref?: string;
  quoteLabel?: string;
  id?: string;
}

const {
  heading,
  image,
  slotId,
  focal = '50% 50%',
  quoteCta = false,
  quoteHref = '/contact-us/',
  quoteLabel = 'Request a quote',
  id = 'close',
} = Astro.props;
---

<section class="shell closing" aria-labelledby={`${id}-title`}>
  <div class="closing-panel">
    <div class="closing-copy">
      <p class="eyebrow closing-eyebrow">Call or request a quote</p>
      <h2 id={`${id}-title`} class="type-section closing-heading">{heading}</h2>
      <p class="closing-line"><slot>Call the shop, or describe the part and request a quote.</slot></p>
      <div class="cmb-actions closing-actions">
        <EntityFact field="primaryPhone" cta="call" class="cmb-pill cmb-pill--call is-large" />
        <a href={quoteHref} data-cta={quoteCta ? 'quote' : undefined} class="cmb-outline is-large closing-quote">{quoteLabel}</a>
      </div>
    </div>
    <div class="closing-media" data-slot={slotId} data-visual="decorative" style={`--closing-focal: ${focal};`}>
      <ResponsiveImage src={image} alt="" decorative sizes="(min-width: 60rem) 28rem, 100vw" />
    </div>
  </div>
</section>

<style>
  .closing {
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
  }
  .closing-panel {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    background-color: var(--cmb-steel-tint);
    border-radius: var(--cmb-radius-lg);
  }
  .closing-copy {
    display: grid;
    gap: 1.15rem;
    align-content: center;
    justify-items: start;
  }
  .closing-eyebrow {
    color: var(--color-on-surface-muted);
  }
  .closing-heading {
    max-inline-size: 16ch;
  }
  .closing-line {
    max-inline-size: 34rem;
    color: var(--color-on-surface-muted);
    font-size: 1.0625rem;
  }
  .closing-actions {
    margin-block-start: 0.5rem;
  }
  .closing-quote {
    color: var(--color-primary);
  }
  .closing-media {
    overflow: hidden;
    border-radius: var(--cmb-radius);
    aspect-ratio: 4 / 3;
  }
  .closing-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--closing-focal);
  }
  @media (min-width: 60rem) {
    .closing-panel {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
    .closing-media {
      aspect-ratio: 4 / 5;
    }
  }
</style>
