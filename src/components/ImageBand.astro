---
/**
 * ImageBand — a full-bleed blued-steel band with a generated place image
 * behind it (approved visual direction: "How a job works — one full-bleed band
 * (foothills or shop light under steel)"). Steel first, place second; the
 * words and frosted panels sit on top. Layout inside is the page's own.
 *
 * The image is generated supporting imagery: empty alt, never captioned.
 */
import type { ImageMetadata } from 'astro';
import ResponsiveImage from './primitives/ResponsiveImage.astro';

interface Props {
  image: ImageMetadata;
  slotId: string;
  focal?: string;
  class?: string;
  [key: string]: unknown;
}

const { image, slotId, focal = '50% 50%', class: className, ...rest } = Astro.props;
---

<section class:list={['image-band', 'on-dark', className]} style={`--band-focal: ${focal};`} {...rest}>
  <div class="image-band-media" data-slot={slotId} data-visual="decorative">
    <ResponsiveImage src={image} alt="" decorative sizes="100vw" />
  </div>
  <slot />
</section>

<style>
  .image-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 3.5rem + 5vw, 8rem);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .image-band-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .image-band-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--band-focal);
  }
  .image-band-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-primary) 70%, transparent) 0%,
      color-mix(in srgb, var(--color-primary) 34%, transparent) 50%,
      color-mix(in srgb, var(--color-primary) 62%, transparent) 100%
    );
  }
</style>
