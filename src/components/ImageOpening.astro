---
/**
 * ImageOpening — every page's opening (approved visual direction, "Words on
 * metal"): a full-bleed generated material image that runs up behind the
 * floating header card, a blued-steel scrim deepest on the left, and the
 * page's words set directly on it — eyebrow, very large heading, one lede and
 * the actions. Never a framed image laid over the hero; never crowded.
 *
 * The image is generated supporting imagery (visual/image-plan.md): empty alt,
 * never captioned, never presented as CMB's work or premises.
 *
 * Slots: "crumbs" (Breadcrumbs on inner pages), "eyebrow", default (h1 +
 * lede), "actions".
 */
import type { ImageMetadata } from 'astro';
import ResponsiveImage from './primitives/ResponsiveImage.astro';

interface Props {
  image: ImageMetadata;
  slotId: string;
  /** CSS object-position: the image-plan slot's focal point. */
  focal?: string;
  /** "tall" for the home opening, "standard" for inner pages. */
  size?: 'tall' | 'standard';
  class?: string;
}

const { image, slotId, focal = '50% 50%', size = 'standard', class: className } = Astro.props;
---

<section class:list={['opening', 'on-dark', `opening--${size}`, className]} style={`--opening-focal: ${focal};`}>
  <div class="opening-media" data-slot={slotId} data-visual="decorative">
    <ResponsiveImage src={image} alt="" decorative sizes="100vw" priority />
  </div>
  <div class="shell opening-inner">
    {Astro.slots.has('crumbs') && <div class="opening-crumbs"><slot name="crumbs" /></div>}
    <div class="opening-copy">
      <p class="eyebrow opening-eyebrow"><slot name="eyebrow" /></p>
      <slot />
      {Astro.slots.has('actions') && <div class="cmb-actions opening-actions"><slot name="actions" /></div>}
    </div>
  </div>
</section>

<style>
  .opening {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(-1 * var(--header-overlap));
    padding-block: calc(var(--header-overlap) + clamp(4rem, 2.5rem + 6vw, 7.5rem)) clamp(3rem, 2rem + 3vw, 5rem);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .opening-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .opening-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--opening-focal);
  }
  /* Phones: words sit over most of the frame, so the scrim is even and deep. */
  .opening-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-primary) 62%, transparent) 0%,
      color-mix(in srgb, var(--color-primary) 55%, transparent) 40%,
      color-mix(in srgb, var(--color-primary) 88%, transparent) 100%
    );
  }
  .opening-inner {
    display: grid;
    gap: 1.5rem;
  }
  .opening-crumbs {
    color: color-mix(in srgb, var(--color-on-primary) 82%, transparent);
  }
  .opening-crumbs :global(a) {
    color: var(--color-on-primary);
  }
  .opening-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-inline-size: 46rem;
  }
  .opening-copy :global(h1) {
    color: var(--color-on-primary);
    max-inline-size: 12ch;
  }
  .opening-copy :global(.type-lede) {
    max-inline-size: 32rem;
    color: color-mix(in srgb, var(--color-on-primary) 90%, transparent);
  }
  .opening-eyebrow {
    color: color-mix(in srgb, var(--color-on-primary) 84%, transparent);
  }
  .opening-actions {
    margin-block-start: 0.5rem;
  }
  .opening-actions :global(.cmb-outline) {
    color: var(--color-on-primary);
  }

  @media (min-width: 60rem) {
    .opening--tall {
      min-block-size: min(52rem, 100svh);
      display: grid;
      align-items: end;
    }
    .opening--standard {
      min-block-size: 34rem;
      display: grid;
      align-items: end;
    }
    /* Wide screens: steel deepest on the left behind the words; the metal
       reads on the right. */
    .opening-media::after {
      background:
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-primary) 90%, transparent) 0%,
          color-mix(in srgb, var(--color-primary) 66%, transparent) 38%,
          color-mix(in srgb, var(--color-primary) 12%, transparent) 70%,
          transparent 100%
        ),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-primary) 35%, transparent) 0%,
          transparent 24%,
          transparent 72%,
          color-mix(in srgb, var(--color-primary) 45%, transparent) 100%
        );
    }
  }
</style>
