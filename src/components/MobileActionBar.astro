---
/**
 * MobileActionBar — the phone-width sticky bar. Text a photo is the owner's
 * preferred contact (facts.md), so it is the amber action; Call sits beside
 * it. The starter's StickyMobileCTA carries one action; this composes the same
 * mechanics (fixed below 48rem, safe-area aware, a spacer so it never covers
 * the page end) with two.
 *
 * Both links are built from the entity's phone (PhoneAction), never typed.
 */
import PhoneAction from './PhoneAction.astro';
---

<div class="mobile-bar-spacer" aria-hidden="true"></div>
<nav class="mobile-bar" aria-label="Text or call the shop">
  <PhoneAction kind="sms" cta="text" label="Text a photo" class="cmb-pill mobile-bar-text" />
  <PhoneAction kind="tel" cta="call" label="Call" class="cmb-outline mobile-bar-call" />
</nav>

<style>
  .mobile-bar,
  .mobile-bar-spacer {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .mobile-bar-spacer {
      display: block;
      block-size: calc(4.5rem + env(safe-area-inset-bottom, 0px));
      background-color: var(--color-graphite);
    }
    .mobile-bar {
      display: flex;
      gap: 0.6rem;
      position: fixed;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 40;
      padding: 0.65rem var(--spacing-gutter) calc(0.65rem + env(safe-area-inset-bottom, 0px));
      background-color: var(--color-graphite);
      box-shadow: 0 -10px 30px -18px color-mix(in srgb, var(--color-graphite) 60%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .mobile-bar :global(.mobile-bar-text) {
      flex: 1.4;
    }
    .mobile-bar :global(.mobile-bar-call) {
      flex: 1;
      color: var(--color-on-graphite);
    }
  }
</style>
