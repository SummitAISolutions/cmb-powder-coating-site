---
/**
 * Opener — every page's opening, composed like the closing CTA (Samuel,
 * 2026-10-07, after the Grill Docs grammar): a graphite field that runs up
 * behind the floating header card, the page's own real work photo set on the
 * right and faded into the graphite, and the words set directly on it —
 * eyebrow, heading, one lede, then an amber rule over the actions.
 *
 * Phones: the photo fills the opening under a graphite scrim and the words sit
 * over it.
 *
 * A real photo carries its alt text (src/lib/work.ts); a generated image is
 * decorative (empty alt) and only used where no real photo can serve.
 *
 * Slots: "crumbs", "eyebrow", default (h1 + lede), "actions", "after"
 * (below the actions, e.g. a rating line).
 */
import type { ImageMetadata } from 'astro';
import ResponsiveImage from './primitives/ResponsiveImage.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  slotId: string;
  decorative?: boolean;
  /** CSS object-position for the photo. */
  focal?: string;
  /** Phone object-position, when it differs. */
  mobileFocal?: string;
  size?: 'tall' | 'standard';
  class?: string;
}

const { image, alt, slotId, decorative = false, focal = '50% 50%', mobileFocal, size = 'standard', class: className } = Astro.props;
---

<section class:list={['opener', 'on-dark', `opener--${size}`, className]} style={`--opener-focal: ${focal}; --opener-focal-mobile: ${mobileFocal ?? focal};`}>
  <div class="opener-media" data-slot={slotId} data-visual={decorative ? 'decorative' : 'editorial'}>
    <ResponsiveImage src={image} alt={alt} decorative={decorative} sizes="(min-width: 60rem) 58vw, 100vw" priority />
  </div>
  <div class="shell opener-inner">
    {Astro.slots.has('crumbs') && <div class="opener-crumbs"><slot name="crumbs" /></div>}
    <div class="opener-copy">
      {Astro.slots.has('eyebrow') && <p class="eyebrow opener-eyebrow"><slot name="eyebrow" /></p>}
      <slot />
      {Astro.slots.has('actions') && <div class="cmb-actions opener-actions"><slot name="actions" /></div>}
      <slot name="after" />
    </div>
  </div>
</section>

<style>
  .opener {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(-1 * var(--header-overlap));
    padding-block: calc(var(--header-overlap) + clamp(5rem, 3rem + 8vw, 8rem)) clamp(2.75rem, 2rem + 3vw, 4.5rem);
    background-color: var(--color-graphite);
    color: var(--color-on-graphite);
  }
  .opener-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .opener-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--opener-focal-mobile);
  }
  /* Phones: the words sit over the photo, so the scrim deepens from the top
     of the copy down. */
  .opener-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-graphite) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-graphite) 72%, transparent) 38%,
      color-mix(in srgb, var(--color-graphite) 92%, transparent) 100%
    );
  }
  .opener-inner {
    display: grid;
    gap: 1.25rem;
  }
  .opener-crumbs {
    color: color-mix(in srgb, var(--color-on-graphite) 84%, transparent);
  }
  .opener-crumbs :global(a) {
    color: var(--color-on-graphite);
  }
  .opener-copy {
    display: grid;
    gap: 1.15rem;
    justify-items: start;
    max-inline-size: 40rem;
  }
  .opener-copy :global(h1) {
    color: var(--color-on-graphite);
    max-inline-size: 13ch;
  }
  .opener-copy :global(.type-lede) {
    max-inline-size: 31rem;
    color: color-mix(in srgb, var(--color-on-graphite) 90%, transparent);
  }
  .opener-eyebrow {
    color: var(--color-action);
  }
  .opener-actions {
    margin-block-start: 0.6rem;
    padding-block-start: 1.4rem;
    border-block-start: 3px solid var(--color-action);
    min-inline-size: min(100%, 26rem);
  }
  .opener-actions :global(.cmb-outline) {
    color: var(--color-on-graphite);
  }

  @media (min-width: 60rem) {
    .opener {
      display: grid;
      align-items: center;
      padding-block: calc(var(--header-overlap) + 5rem) 4.5rem;
    }
    .opener--tall {
      min-block-size: min(50rem, 100svh);
    }
    .opener--standard {
      min-block-size: min(40rem, 88svh);
    }
    .opener-media {
      inset-inline-start: auto;
      inline-size: 58%;
    }
    .opener-media :global(img) {
      object-position: var(--opener-focal);
    }
    /* Wide screens: the photo sits on the right and fades into the graphite
       behind the words. */
    .opener-media::after {
      background:
        linear-gradient(
          90deg,
          var(--color-graphite) 0%,
          color-mix(in srgb, var(--color-graphite) 70%, transparent) 18%,
          color-mix(in srgb, var(--color-graphite) 10%, transparent) 46%,
          transparent 100%
        ),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-graphite) 40%, transparent) 0%,
          transparent 22%,
          transparent 80%,
          color-mix(in srgb, var(--color-graphite) 45%, transparent) 100%
        );
    }
    .opener-copy {
      max-inline-size: 36rem;
    }
  }
</style>
