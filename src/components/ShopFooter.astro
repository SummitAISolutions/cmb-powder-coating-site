---
/**
 * ShopFooter — graphite footer (approved visual direction): the name, one
 * line, the links, how to reach the shop, and the Summit credit. Every fact
 * comes from the entity through EntityFact.
 */
import EntityFact from './primitives/EntityFact.astro';
import SiteFooter from './primitives/SiteFooter.astro';
import PhoneAction from './PhoneAction.astro';
import Stars from './Stars.astro';
import { GOOGLE_PROFILE_URL, GOOGLE_RATING, GOOGLE_REVIEW_COUNT } from '../lib/reviews';
import { searchContext } from '../lib/local-search/site-context';

const { entity } = searchContext();
---

<SiteFooter class="shop-footer on-dark">
  <div class="shell shop-footer-shell">
  <div class="shop-footer-grid">
    <div class="shop-footer-id">
      <EntityFact field="publicName" class="shop-footer-name" />
      <p class="shop-footer-line">Powder coating in Boise, serving <EntityFact field="serviceAreas" />.</p>
      <a href="/reviews/" class="shop-footer-rating"><Stars class="shop-footer-stars" /> <span>{GOOGLE_RATING} on Google, {GOOGLE_REVIEW_COUNT} reviews</span></a>
      <a href={GOOGLE_PROFILE_URL} rel="noopener" target="_blank">Leave a review on Google <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
    </div>
    <nav aria-label="Footer" class="shop-footer-nav">
      <ul role="list">
        <li><a href="/">Home</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/our-work/">Our work</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/contact-us/">Request a quote</a></li>
      </ul>
    </nav>
    <div class="shop-footer-reach">
      <PhoneAction kind="sms" label="Text a photo" showNumber class="shop-footer-text" />
      <EntityFact field="primaryPhone" class="shop-footer-call" />
      <EntityFact field="email" />
      <EntityFact field="address" />
    </div>
  </div>
  <p class="shop-footer-credit">{entity.legalName && <span>© {entity.legalName}</span>} <span>Website built by <strong>Summit AI Solutions</strong></span></p>
  </div>
</SiteFooter>

<style>
  .shop-footer {
    padding-block: clamp(3rem, 2.5rem + 2vw, 4.5rem) 2rem;
    background-color: color-mix(in srgb, var(--color-graphite) 90%, var(--color-primary));
    border-block-start: 3px solid var(--color-action);
    color: var(--color-on-graphite);
  }
  /* Align with the page shell inside the primitive's wide container. */
  .shop-footer-shell {
    inline-size: 100%;
  }
  .shop-footer-grid {
    display: grid;
    gap: 2.25rem;
  }
  .shop-footer-id {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .shop-footer :global([data-entity='publicName']) {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--font-weight-display, 600);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    line-height: 1;
  }
  .shop-footer-rating {
    gap: 0.6rem;
  }
  .shop-footer-id :global(.shop-footer-stars) {
    font-size: 0.9rem;
  }
  .shop-footer :global(.shop-footer-call)::before {
    content: 'Call\00a0';
  }
  .shop-footer-line {
    max-inline-size: 34ch;
    color: color-mix(in srgb, var(--color-on-graphite) 78%, transparent);
  }
  .shop-footer-nav ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }
  .shop-footer a,
  .shop-footer :global(a) {
    color: var(--color-on-graphite);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: var(--tap-target);
  }
  .shop-footer a:hover,
  .shop-footer :global(a:hover) {
    text-decoration: underline;
    text-decoration-color: var(--color-action);
    text-underline-offset: 0.35em;
  }
  .shop-footer-reach {
    display: grid;
    gap: 0.1rem;
    align-content: start;
  }
  .shop-footer-reach :global(address) {
    margin-block-start: 0.6rem;
    color: color-mix(in srgb, var(--color-on-graphite) 78%, transparent);
    line-height: 1.5;
  }
  .shop-footer-credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block-start: 1.5rem;
    margin-block-start: 3rem;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-on-graphite) 66%, transparent);
  }
  @media (min-width: 48rem) {
    .shop-footer-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
</style>
