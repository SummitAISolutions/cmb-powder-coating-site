---
/**
 * Stars — five filled stars for the authorised Google rating (facts.md
 * "Ratings/counts authorized for display": 5.0). Decorative: the rating is
 * always stated in text beside it. Drawn in currentColor.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['stars', className]} aria-hidden="true">
  {Array.from({ length: 5 }, () => (
    <svg viewBox="0 0 20 20" width="20" height="20" focusable="false"><path fill="currentColor" d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z" /></svg>
  ))}
</span>

<style>
  .stars {
    display: inline-flex;
    gap: 0.2em;
    color: var(--color-action);
    line-height: 0;
  }
  .stars svg {
    inline-size: 1.25em;
    block-size: 1.25em;
  }
</style>
