---
/**
 * ShopLayout — BaseLayout plus CMB Powder Coating's shared chrome: the
 * self-hosted faces, the floating header card, the graphite footer and, on
 * phones, the sticky Text + Call bar.
 */
import BaseLayout from './BaseLayout.astro';
import ShopHeader from '../components/ShopHeader.astro';
import ShopFooter from '../components/ShopFooter.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { routeContext } from '../lib/local-search/site-context';

interface Props {
  routeId: string;
}

const { routeId } = Astro.props;
routeContext(routeId);
---

<BaseLayout routeId={routeId}>
  <Fragment slot="head">
    {/* The display face carries the largest contentful paint, so it is
        preloaded; the body faces arrive with the stylesheet. Self-hosted on
        the same origin: no third-party font request. */}
    <link rel="preload" href="/fonts/barlow-condensed-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts.css" />
  </Fragment>
  <ShopHeader slot="header" />
  <slot />
  <ShopFooter slot="footer" />
  <MobileActionBar slot="after" />
</BaseLayout>
