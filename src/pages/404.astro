---
/**
 * The custom 404 page. Astro writes it to dist/404.html; Cloudflare Pages
 * answers unknown paths with it and a 404 status (without it, Pages would
 * answer every unknown path with the home page and a 200 — a soft 404).
 *
 * Same grammar as every page: an opening, then the closing panel.
 */
import ShopLayout from '../layouts/ShopLayout.astro';
import ImageOpening from '../components/ImageOpening.astro';
import ClosingPanel from '../components/ClosingPanel.astro';
import { routeContext } from '../lib/local-search/site-context';

import openingImage from '../assets/generated/services-opening.webp';
import closingImage from '../assets/generated/closing-powder.webp';

const { route } = routeContext('not-found');
---

<ShopLayout routeId="not-found">
  <ImageOpening image={openingImage} slotId="services-opening" focal="72% 50%">
    <Fragment slot="eyebrow">Error 404</Fragment>
    <h1 class="type-hero">{route.heading}</h1>
    <p class="type-lede">That page does not exist, or it moved when the site was rebuilt.</p>
    <Fragment slot="actions">
      <a href="/" class="cmb-outline is-large">Back to the home page</a>
      <a href="/services/" class="cmb-outline is-large">See the services</a>
    </Fragment>
  </ImageOpening>

  <ClosingPanel heading="Looking for a quote?" image={closingImage} slotId="closing-powder" focal="60% 50%" />
</ShopLayout>
