---
/**
 * [STARTER PLACEHOLDER] — the custom 404 page.
 *
 * Astro writes it to dist/404.html. Cloudflare Pages answers unknown paths
 * with that page and a 404 status; without it, Pages treats the site as a
 * single-page app and answers every unknown path with the home page and a 200
 * (a soft 404, which Stage 4 checks at the edge). Keep the page; restyle and
 * reword it per client.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/primitives/Button.astro';
import Container from '../components/primitives/Container.astro';
import SiteHeader from '../components/primitives/SiteHeader.astro';
import Stack from '../components/primitives/Stack.astro';
---

<BaseLayout routeId="not-found">
  <SiteHeader slot="header" brand="[STARTER PLACEHOLDER]" links={[{ href: '/', label: 'Placeholder link' }]} />
  <Container as="section" class="section-space" aria-labelledby="not-found-title">
    <Stack space="gutter">
      <h1 id="not-found-title" class="type-display">Page not found</h1>
      <p class="type-body measure">[STARTER PLACEHOLDER] The page you asked for does not exist.</p>
      <div><Button href="/">Back to the home page</Button></div>
    </Stack>
  </Container>
</BaseLayout>
