---
/**
 * Contact / request a quote (search/site.json "contact"). Texting a photo is
 * the owner's preferred contact (facts.md), so it comes first.
 *
 * Rhythm: graphite opener on a real white wheel → primer: a graphite panel
 * (text first, then call, the shop address and directions, appointment hours,
 * email) beside a primer-deep panel holding the approved quote form (LeadForm
 * "quote") → steel reviews band → graphite closing CTA.
 *
 * Every fact comes from the entity; every promise from facts.md through
 * <Commitment>.
 */
import ShopLayout from '../layouts/ShopLayout.astro';
import Opener from '../components/Opener.astro';
import ReviewsBand from '../components/ReviewsBand.astro';
import ClosingCta from '../components/ClosingCta.astro';
import DirectionsLink from '../components/DirectionsLink.astro';
import PhoneAction from '../components/PhoneAction.astro';
import Breadcrumbs from '../components/primitives/Breadcrumbs.astro';
import Commitment from '../components/primitives/Commitment.astro';
import EntityFact from '../components/primitives/EntityFact.astro';
import LeadForm from '../components/primitives/LeadForm.astro';
import { routeContext } from '../lib/local-search/site-context';
import { work } from '../lib/work';

const { route } = routeContext('contact');
const opening = work('white-face');
const closing = work('gunmetal-pair');
---

<ShopLayout routeId="contact">
  <Opener image={opening.src} alt={opening.alt} slotId="work-photos" focal="50% 50%">
    <Breadcrumbs slot="crumbs" routeId="contact" />
    <h1 class="type-hero">{route.heading}</h1>
    <p class="type-lede">Text a photo of the part, call the shop, or send the details in the form below.</p>
    <Fragment slot="actions">
      <PhoneAction kind="sms" cta="text" label="Text a photo for a quote" class="cmb-pill is-large" />
      <EntityFact field="primaryPhone" cta="call" class="cmb-outline cmb-pill--call is-large" />
    </Fragment>
  </Opener>

  <section class="surface-primer section-pad" aria-label="Text, call or request a quote">
    <div class="shell reach">
      <div class="reach-panel surface-graphite">
        <div class="reach-block reach-block--text">
          <h2 class="reach-title">Text a photo</h2>
          <PhoneAction kind="sms" cta="text" label="Text" showNumber class="reach-sms" />
          <Commitment id="text-quotes" as="p" class="reach-note" />
        </div>
        <div class="reach-block">
          <h2 class="reach-label">Or call</h2>
          <EntityFact field="primaryPhone" cta="call" class="reach-phone" />
        </div>
        <div class="reach-block">
          <h2 class="reach-label">The shop</h2>
          <EntityFact field="address" class="reach-address" />
          <Commitment id="hours" as="p" class="reach-note" />
          <DirectionsLink class="cmb-solid-light reach-directions" />
        </div>
        <div class="reach-block">
          <h2 class="reach-label">Email</h2>
          <EntityFact field="email" class="reach-email" />
        </div>
      </div>

      <div id="quote-form" class="reach-form">
        <h2 class="type-section reach-form-title">Or describe the part</h2>
        <p class="reach-form-line">What it is, its rough size, the metal, its current finish and the colour you want.</p>
        <LeadForm
          formId="quote"
          submitLabel="Request a quote"
          class="reach-lead"
          messages={{
            received: 'Thank you. Your quote request was sent.',
            failed: 'Your request could not be sent. Please try again, or text or call the shop.',
            pending: 'We could not confirm that your request arrived. Please text or call the shop.',
          }}
        />
      </div>
    </div>
  </section>

  <ReviewsBand reviews={['review-jeff', 'review-randy', 'review-matthew', 'review-ben']} />

  <ClosingCta heading="Rather talk it through?" image={closing.src} alt={closing.alt} slotId="work-photos" focal="50% 50%" quoteHref="#quote-form" quoteLabel="Back to the form">
    Text or call the shop and describe the part.
  </ClosingCta>
</ShopLayout>

<style>
  .reach {
    display: grid;
    gap: 1rem;
  }
  .reach-panel {
    display: grid;
    gap: 2rem;
    align-content: start;
    padding: clamp(1.75rem, 1.25rem + 2.5vw, 3.25rem);
    border-radius: var(--cmb-radius);
  }
  .reach-block {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .reach-block--text {
    padding-block-end: 1.75rem;
    border-block-end: 3px solid var(--color-action);
  }
  .reach-title {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    line-height: 1;
  }
  .reach-panel :global(.reach-sms) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.35em;
    font-family: var(--font-display), sans-serif;
    font-weight: var(--font-weight-display, 600);
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    line-height: 1;
    color: var(--color-action);
    text-decoration: none;
  }
  .reach-panel :global(.reach-sms:hover) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .reach-panel :global(.reach-note) {
    max-inline-size: 30rem;
    color: color-mix(in srgb, var(--color-on-graphite) 86%, transparent);
  }
  .reach-label {
    font-family: var(--font-label), sans-serif;
    font-size: var(--text-label);
    font-weight: var(--font-weight-label, 500);
    letter-spacing: var(--tracking-label, 0.14em);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-on-graphite) 78%, transparent);
  }
  .reach-panel :global(.reach-phone) {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--font-weight-display, 600);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1;
    color: var(--color-on-graphite);
    text-decoration: underline;
    text-decoration-color: var(--color-action);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
  }
  .reach-panel :global(.reach-address) {
    font-size: 1.25rem;
    line-height: 1.45;
  }
  .reach-panel :global(.reach-directions) {
    margin-block-start: 0.4rem;
  }
  .reach-panel :global(.reach-email) {
    color: var(--color-on-graphite);
    font-size: 1.125rem;
    overflow-wrap: anywhere;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
  }
  .reach-form {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.75rem, 1.25rem + 2.5vw, 3.25rem);
    background-color: var(--cmb-primer-deep);
    border-radius: var(--cmb-radius);
  }
  .reach-form-line {
    max-inline-size: 36rem;
    color: var(--color-on-surface-muted);
  }
  .reach-form :global(.reach-lead) {
    margin-block-start: 0.75rem;
  }
  /* The approved form, dressed for this site through element and attribute
     selectors only (the primitive's internals are its own). */
  .reach-form :global(.reach-lead input:not([type='checkbox']):not([type='hidden'])),
  .reach-form :global(.reach-lead select),
  .reach-form :global(.reach-lead textarea) {
    background-color: var(--cmb-primer-light);
    border-radius: var(--cmb-radius-sm);
  }
  .reach-form :global(.reach-lead label) {
    font-family: var(--font-body), sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .reach-form :global(.reach-lead button[type='submit']) {
    min-block-size: 3.5rem;
    padding-inline: 1.75rem;
    border-radius: var(--cmb-radius-sm);
    background-color: var(--color-action);
    color: var(--color-on-action);
    font-family: var(--font-body), sans-serif;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .reach-form :global(.reach-lead button[type='submit']:hover) {
    background-color: color-mix(in srgb, var(--color-action) 88%, var(--color-on-surface));
  }
  .reach-form :global(.reach-lead button[type='submit']:focus-visible) {
    outline-color: var(--color-on-surface);
  }
  @media (min-width: 60rem) {
    .reach {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 1rem;
      align-items: start;
    }
  }
</style>
