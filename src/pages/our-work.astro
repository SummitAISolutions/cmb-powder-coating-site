---
/**
 * Our Work — the evidence gallery (search/site.json "our-work"). All nineteen
 * of the owner's real work photos, grouped by part type, each uncropped with
 * alt text describing the real part and finish and a short caption
 * (src/lib/work.ts). Nothing here is generated or retouched.
 *
 * Rhythm: graphite opener → primer wheels and rims (masonry, uncropped) →
 * graphite calipers and frames → steel-tint equipment and commercial → steel
 * reviews band → graphite closing CTA.
 */
import ShopLayout from '../layouts/ShopLayout.astro';
import Opener from '../components/Opener.astro';
import ReviewsBand from '../components/ReviewsBand.astro';
import ClosingCta from '../components/ClosingCta.astro';
import PhoneAction from '../components/PhoneAction.astro';
import Breadcrumbs from '../components/primitives/Breadcrumbs.astro';
import Commitment from '../components/primitives/Commitment.astro';
import EntityFact from '../components/primitives/EntityFact.astro';
import ResponsiveImage from '../components/primitives/ResponsiveImage.astro';
import { routeContext } from '../lib/local-search/site-context';
import { work, workPhotos, WORK_GROUPS } from '../lib/work';

const { route } = routeContext('our-work');
const name = (id: string) => WORK_GROUPS.find((group) => group.id === id)!.name;

const opening = work('textured-metallic');
const wheels = workPhotos('wheels');
const caliper = workPhotos('calipers')[0];
const frame = workPhotos('frames')[0];
const equipment = workPhotos('equipment');
const closing = work('light-blue-pair-2');
---

<ShopLayout routeId="our-work">
  <Opener image={opening.src} alt={opening.alt} slotId="work-photos" focal="50% 45%">
    <Breadcrumbs slot="crumbs" routeId="our-work" />
    <h1 class="type-hero">{route.heading}</h1>
    <p class="type-lede">Real parts from the shop: wheels and rims, brake calipers, frames, equipment and more.</p>
    <Fragment slot="actions">
      <PhoneAction kind="sms" cta="text" label="Text a photo of your part" class="cmb-pill is-large" />
      <EntityFact field="primaryPhone" cta="call" class="cmb-outline cmb-pill--call is-large" />
    </Fragment>
  </Opener>

  <nav class="surface-deep jump" aria-label="Work by part type">
    <ul class="shell jump-list" role="list">
      {WORK_GROUPS.map((group) => <li><a href={`#${group.id}`}>{group.name}</a></li>)}
    </ul>
  </nav>

  <section id="wheels" class="surface-primer section-pad" aria-labelledby="wheels-title">
    <div class="shell gallery">
      <div class="cmb-head">
        <h2 id="wheels-title" class="type-section">{name('wheels')}</h2>
        <p>Gloss black, gloss red, white, silver, gunmetal, light blue, bronze, copper metal flake and a dark textured metallic.</p>
      </div>
      <ul class="masonry" role="list" data-slot="work-photos" data-visual="editorial">
        {wheels.map((photo) => (
          <li class="shot">
            <figure>
              <ResponsiveImage src={photo.src} alt={photo.alt} sizes="(min-width: 64rem) 24rem, 50vw" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="surface-graphite section-pad" aria-label="Brake calipers and frames">
    <div class="shell pair">
      {[{ id: 'calipers', photo: caliper, line: 'A pair of brake calipers, coated silver.' }, { id: 'frames', photo: frame, line: 'An electric bike frame, coated satin black.' }].map((item) => (
        <article id={item.id} class="pair-item" aria-labelledby={`${item.id}-title`}>
          <figure class="pair-photo" data-slot="work-photos" data-visual="editorial">
            <ResponsiveImage src={item.photo.src} alt={item.photo.alt} sizes="(min-width: 60rem) 36rem, 100vw" />
          </figure>
          <h2 id={`${item.id}-title`} class="type-section pair-title">{name(item.id)}</h2>
          <p class="pair-line">{item.line}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="equipment" class="surface-tint section-pad" aria-labelledby="equipment-title">
    <div class="shell equip">
      <div class="cmb-head equip-head">
        <h2 id="equipment-title" class="type-section">{name('equipment')}</h2>
        <Commitment id="customers" as="p" />
        <PhoneAction kind="sms" cta="text" label="Text a photo for a quote" class="cmb-pill is-large equip-cta" />
      </div>
      <div class="equip-photos">
        {equipment.map((photo) => (
          <figure class="equip-photo" data-slot="work-photos" data-visual="editorial">
            <ResponsiveImage src={photo.src} alt={photo.alt} sizes="(min-width: 60rem) 30rem, 100vw" />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ReviewsBand reviews={['review-edward', 'review-daniil', 'review-ben', 'review-brentech']} />

  <ClosingCta heading="Want your part to look like this?" image={closing.src} alt={closing.alt} slotId="work-photos" focal="50% 50%" quoteCta />
</ShopLayout>

<style>
  .jump {
    padding-block: 0.75rem;
  }
  .jump-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .jump-list a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
    padding-inline: 1rem;
    border-radius: var(--cmb-radius-sm);
    background-color: var(--color-surface);
    color: var(--color-on-surface);
    font-weight: 500;
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--cmb-line);
  }
  .jump-list a:hover {
    box-shadow: inset 0 0 0 2px var(--color-action);
  }

  .gallery {
    display: grid;
    gap: 2.25rem;
  }
  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 0.5rem;
  }
  .shot {
    break-inside: avoid;
    margin-block-end: 0.5rem;
  }
  .shot figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--cmb-radius-sm);
    background-color: var(--color-graphite);
  }
  .shot :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .shot figcaption,
  .equip-photo figcaption {
    padding: 0.7rem 0.9rem 0.8rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-on-graphite);
    border-block-start: 3px solid var(--color-action);
  }
  @media (max-width: 39.99rem) {
    .shot figcaption {
      padding: 0.5rem 0.6rem 0.6rem;
      font-size: 0.8125rem;
    }
  }
  @media (min-width: 40rem) {
    .masonry {
      column-gap: 0.75rem;
    }
    .shot {
      margin-block-end: 0.75rem;
    }
  }
  @media (min-width: 64rem) {
    .masonry {
      columns: 3;
    }
  }

  .pair {
    display: grid;
    gap: 3rem;
  }
  .pair-item {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .pair-photo {
    margin: 0 0 0.5rem;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--cmb-radius-sm);
  }
  .pair-photo :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .pair-line {
    max-inline-size: 30rem;
    color: color-mix(in srgb, var(--color-on-graphite) 86%, transparent);
    font-size: 1.0625rem;
  }
  @media (min-width: 60rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
    .pair-item:first-child .pair-photo {
      aspect-ratio: 4 / 5;
    }
    .pair-item:last-child {
      margin-block-start: 6rem;
    }
  }

  .equip {
    display: grid;
    gap: 2.5rem;
  }
  .equip-head {
    align-content: start;
    justify-items: start;
  }
  .equip-head :global(.equip-cta) {
    margin-block-start: 0.5rem;
  }
  .equip-photos {
    display: grid;
    gap: 0.75rem;
  }
  .equip-photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--cmb-radius-sm);
    background-color: var(--color-graphite);
  }
  .equip-photo :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  @media (min-width: 48rem) {
    .equip-photos {
      grid-template-columns: 0.75fr 1fr;
      align-items: start;
    }
  }
  @media (min-width: 64rem) {
    .equip {
      grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
      gap: 4rem;
    }
  }
</style>
