---
/**
 * Services — the one page for the shop's work in detail (search/site.json
 * "services").
 *
 * Rhythm: graphite opener on real bronze wheels → primer powder coating with
 * real photos → steel-tint sandblasting (mostly prep, the owner's exact
 * wording) → graphite "what to send for a quote" → primer turnaround and
 * customers → steel reviews band → graphite closing CTA.
 *
 * The process copy describes powder coating and sandblasting in general;
 * every promise comes from facts.md through <Commitment>. Prices, size limits,
 * warranties and specialities are not in facts.md, so none are stated.
 */
import ShopLayout from '../layouts/ShopLayout.astro';
import Opener from '../components/Opener.astro';
import ReviewsBand from '../components/ReviewsBand.astro';
import ClosingCta from '../components/ClosingCta.astro';
import PhoneAction from '../components/PhoneAction.astro';
import Breadcrumbs from '../components/primitives/Breadcrumbs.astro';
import Commitment from '../components/primitives/Commitment.astro';
import EntityFact from '../components/primitives/EntityFact.astro';
import ResponsiveImage from '../components/primitives/ResponsiveImage.astro';
import { routeContext } from '../lib/local-search/site-context';
import { work } from '../lib/work';

import blastImage from '../assets/generated/card-sandblasting.webp';

const { entity, route } = routeContext('services');
const serviceName = (id: string) => {
  const service = entity.services.find((entry: { id: string }) => entry.id === id);
  if (!service) throw new Error(`Services: the entity records no service "${id}".`);
  return service.name as string;
};

const opening = work('bronze-pair');
const powderMain = work('gloss-black-angle');
const powderSide = work('white-lip');
const business = work('excavator-bucket');
const closing = work('gloss-black-six-spoke');
---

<ShopLayout routeId="services">
  <Opener image={opening.src} alt={opening.alt} slotId="work-photos" focal="50% 60%" mobileFocal="50% 55%">
    <Breadcrumbs slot="crumbs" routeId="services" />
    <h1 class="type-hero">{route.heading}</h1>
    <p class="type-lede">What the shop coats, what to send for a quote, and how long a job takes.</p>
    <Fragment slot="actions">
      <PhoneAction kind="sms" cta="text" label="Text a photo for a quote" class="cmb-pill is-large" />
      <EntityFact field="primaryPhone" cta="call" class="cmb-outline cmb-pill--call is-large" />
    </Fragment>
  </Opener>

  <section id="powder-coating" class="surface-primer section-pad" aria-labelledby="powder-title">
    <div class="shell svc">
      <div class="svc-copy">
        <h2 id="powder-title" class="type-section">{serviceName('powder-coating')}</h2>
        <p class="svc-lead">Powder coating is a dry finish. Fine powder is sprayed onto clean, bare metal, where an electrostatic charge holds it in place.</p>
        <p>The part is then baked. The heat melts the powder so it flows together and cures into one continuous coating, rather than drying the way paint does.</p>
        <div class="svc-coats">
          <h3 class="svc-sub">What we coat</h3>
          <ul class="svc-chips" role="list">
            <li><a href="/our-work/#wheels">Wheels and rims</a></li>
            <li><a href="/our-work/#calipers">Brake calipers</a></li>
            <li><a href="/our-work/#frames">Frames</a></li>
            <li><a href="/our-work/#equipment">Equipment parts</a></li>
          </ul>
          <Commitment id="colours" as="p" class="svc-note" />
        </div>
      </div>
      <div class="svc-photos">
        <figure class="svc-photo svc-photo--main" data-slot="work-photos" data-visual="editorial">
          <ResponsiveImage src={powderMain.src} alt={powderMain.alt} sizes="(min-width: 60rem) 24rem, 60vw" />
        </figure>
        <figure class="svc-photo svc-photo--side" data-slot="work-photos" data-visual="editorial">
          <ResponsiveImage src={powderSide.src} alt={powderSide.alt} sizes="(min-width: 60rem) 16rem, 40vw" />
        </figure>
      </div>
    </div>
  </section>

  <section id="sandblasting" class="surface-tint section-pad" aria-labelledby="blast-title">
    <div class="shell svc svc--blast">
      <figure class="svc-photo svc-photo--blast" data-slot="card-sandblasting" data-visual="decorative">
        <ResponsiveImage src={blastImage} alt="" decorative sizes="(min-width: 60rem) 30rem, 100vw" />
      </figure>
      <div class="svc-copy">
        <h2 id="blast-title" class="type-section">{serviceName('sandblasting')}</h2>
        <Commitment id="sandblasting-prep" as="p" class="svc-blast-lead" />
        <p>Abrasive blasting strips old paint, old coatings, rust and mill scale, and leaves bare metal with an even surface that a new coating can grip.</p>
        <p>Not sure whether your part needs it? Ask when you text or call.</p>
      </div>
    </div>
  </section>

  <section class="surface-graphite section-pad" aria-labelledby="send-title">
    <div class="shell send">
      <div class="send-head">
        <h2 id="send-title" class="type-section">What to send for a quote</h2>
        <Commitment id="text-quotes" as="p" class="send-line" />
        <EntityFact field="primaryPhone" class="send-number" link={false} />
        <div class="cmb-actions">
          <PhoneAction kind="sms" cta="text" label="Text a photo for a quote" class="cmb-pill is-large" />
          <a href="/contact-us/" data-cta="quote" class="cmb-outline is-large send-form">Use the quote form</a>
        </div>
      </div>
      <ul class="send-list" role="list">
        <li><span class="send-item">A photo of the part</span><span class="send-hint">The whole part, in good light.</span></li>
        <li><span class="send-item">Its size</span><span class="send-hint">Rough dimensions are fine.</span></li>
        <li><span class="send-item">The colour you want</span><span class="send-hint">And the finish, if you know it: gloss, satin, metallic or textured.</span></li>
      </ul>
    </div>
  </section>

  <section class="surface-primer section-pad" aria-labelledby="time-title">
    <div class="shell time">
      <div class="time-card surface-steel">
        <h2 id="time-title" class="type-section">Turnaround</h2>
        <Commitment id="turnaround" as="p" class="time-lead" />
        <Commitment id="quick-turnaround" as="p" />
        <div class="time-rush">
          <h3 class="time-sub">Rush jobs</h3>
          <Commitment id="rush" as="p" />
        </div>
      </div>
      <div class="time-who on-dark">
        <figure class="time-who-media" data-slot="work-photos" data-visual="editorial">
          <ResponsiveImage src={business.src} alt={business.alt} sizes="(min-width: 60rem) 36rem, 100vw" />
        </figure>
        <div class="time-who-body">
          <h3 class="time-sub">Individuals and businesses</h3>
          <Commitment id="customers" as="p" />
        </div>
      </div>
    </div>
  </section>

  <ReviewsBand reviews={['review-randy', 'review-edward', 'review-ben', 'review-jeff']} />

  <ClosingCta heading="Ready to send the details?" image={closing.src} alt={closing.alt} slotId="work-photos" focal="50% 50%" quoteCta />
</ShopLayout>

<style>
  .svc {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .svc-copy {
    display: grid;
    gap: 1.1rem;
    align-content: center;
    max-inline-size: 38rem;
  }
  .svc-copy p {
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .svc-copy .svc-lead,
  .svc-copy :global(.svc-lead) {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.375rem);
    line-height: 1.5;
  }
  .svc-copy :global(p.svc-blast-lead.svc-blast-lead) {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--font-weight-display, 600);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1.05;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-action);
  }
  .svc-coats {
    display: grid;
    gap: 0.85rem;
    margin-block-start: 0.75rem;
  }
  .svc-sub {
    font-family: var(--font-display), sans-serif;
    font-size: 1.75rem;
    line-height: 1;
  }
  .svc-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .svc-chips a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
    padding-inline: 1rem;
    border-radius: var(--cmb-radius-sm);
    background-color: var(--color-graphite);
    color: var(--color-on-graphite);
    font-weight: 500;
    text-decoration: none;
  }
  .svc-chips a:hover {
    background-color: var(--color-primary);
  }
  .svc-copy :global(.svc-note) {
    color: var(--color-on-surface-muted);
  }
  .svc-photos {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 0.75rem;
    align-items: end;
  }
  .svc-photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--cmb-radius-sm);
  }
  .svc-photo :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .svc-photo--main {
    aspect-ratio: 3 / 4;
  }
  .svc-photo--side {
    aspect-ratio: 3 / 4;
    margin-block-end: 2.5rem;
  }
  .svc-photo--blast {
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 60rem) {
    .svc {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 5rem;
    }
    .svc--blast {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
    .svc-photo--blast {
      aspect-ratio: 5 / 4;
    }
  }

  .send {
    display: grid;
    gap: 2.75rem;
  }
  .send-head {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    justify-items: start;
  }
  .send-head :global(.send-line) {
    max-inline-size: 30rem;
    font-size: 1.125rem;
    color: color-mix(in srgb, var(--color-on-graphite) 88%, transparent);
  }
  .send-head :global(.send-number) {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--font-weight-display, 600);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    line-height: 1;
    color: var(--color-action);
  }
  .send-form {
    color: var(--color-on-graphite);
  }
  .send-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    align-content: center;
  }
  .send-list li {
    display: grid;
    gap: 0.3rem;
    padding: 1.25rem 1.4rem;
    background-color: color-mix(in srgb, var(--color-primary) 50%, var(--color-graphite));
    border-inline-start: 3px solid var(--color-action);
    border-radius: var(--cmb-radius-sm);
  }
  .send-item {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--font-weight-display, 600);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    line-height: 1.05;
  }
  .send-hint {
    color: color-mix(in srgb, var(--color-on-graphite) 82%, transparent);
  }
  @media (min-width: 60rem) {
    .send {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
      align-items: center;
    }
  }

  .time {
    display: grid;
    gap: 0.75rem;
  }
  .time-card {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.75rem, 1.25rem + 2.5vw, 3.25rem);
    border-radius: var(--cmb-radius);
  }
  .time-card :global(.time-lead) {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--font-weight-display, 600);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1.05;
  }
  .time-card p {
    color: color-mix(in srgb, var(--color-on-primary) 90%, transparent);
  }
  .time-rush {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 1rem;
    padding-block-start: 1.25rem;
    border-block-start: 3px solid var(--color-action);
  }
  .time-sub {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(1.6rem, 1.4rem + 0.8vw, 2.125rem);
    line-height: 1;
  }
  .time-who {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-block-size: 24rem;
    overflow: hidden;
    border-radius: var(--cmb-radius);
    background-color: var(--color-graphite);
    color: var(--color-on-graphite);
  }
  .time-who-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin: 0;
  }
  .time-who-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .time-who-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, color-mix(in srgb, var(--color-graphite) 85%, transparent) 100%);
  }
  .time-who-body {
    display: grid;
    gap: 0.5rem;
    margin: 0.75rem;
    padding: 1.25rem 1.4rem;
    background-color: color-mix(in srgb, var(--color-graphite) 86%, transparent);
    border-block-start: 3px solid var(--color-action);
  }
  @media (min-width: 60rem) {
    .time {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
</style>
